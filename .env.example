# --- Auth (obligatoriskt) ---
# Generera t.ex. med: openssl rand -hex 32
API_KEY=byt-mig-till-en-lang-slumpnyckel

# --- Docker-åtkomst ---
# Shimmen pratar ALDRIG med socketen direkt, bara via proxyn.
DOCKER_HOST=tcp://socket-proxy:2375
DOCKER_TIMEOUT=120

# --- Unraid-template ---
WRITE_TEMPLATE=true
TEMPLATE_DIR=/templates-user

# --- Guardrails ---
# Tom = tillåt alla namn som inte krockar. Kommaseparerad lista för att låsa.
ALLOWED_NAME_PREFIXES=
# Tom = tillåt alla images. Annars kommaseparerade prefix (matchas på /-gräns):
# ALLOWED_REGISTRIES=ghcr.io/armandur,lscr.io,linuxserver
ALLOWED_REGISTRIES=
# Namn som aldrig får skapas (skydd för prod), t.ex.:
# PROTECTED_NAMES=plex,frigate,Nginx-Proxy-Manager-Official
PROTECTED_NAMES=

# Volymer: default-restriktivt. Tom => bara /mnt/user/ tillåts.
ALLOWED_VOLUME_PREFIXES=
# Nekas alltid oavsett allowlist. Tom => en säker default (system + docker.sock).
DENIED_VOLUME_PREFIXES=
# Devices: default-deny. Tom => inga devices får mappas. Annars t.ex.:
# ALLOWED_DEVICE_PREFIXES=/dev/dri,/dev/net/tun
ALLOWED_DEVICE_PREFIXES=
# Privilegierade containrar (= i praktiken root på hosten). Default av.
ALLOW_PRIVILEGED=false

# --- Rate limit på create ---
RATELIMIT_MAX=10
RATELIMIT_WINDOW_S=60

DEFAULT_RESTART=unless-stopped

# --- Endast docker-compose.dev.yml ---
HOST_PORT=8001
